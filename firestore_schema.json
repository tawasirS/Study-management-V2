{
    "collections": {
        "users": {
            "docId": "userId",
            "fields": {
                "displayName": "string",
                "email": "string",
                "photoURL": "string | null",
                "createdAt": "timestamp"
            },
            "indexesSuggestion": []
        },
        "subjects": {
            "docId": "subjectId",
            "fields": {
                "code": "string",
                "name": "string",
                "ownerTeacherName": "string",
                "memberUserIds": "string[]",
                "createdAt": "timestamp",
                "updatedAt": "timestamp"
            },
            "indexesSuggestion": [
                "memberUserIds ASC, createdAt DESC"
            ]
        },
        "studyTimes": {
            "docId": "studyTimeId",
            "fields": {
                "subjectId": "string",
                "startAt": "timestamp",
                "endAt": "timestamp",
                "room": "string",
                "teacherName": "string",
                "type": "string (enum: lecture, lab, tutorial, exam, other)",
                "participantUserIds": "string[]",
                "createdAt": "timestamp",
                "updatedAt": "timestamp"
            },
            "indexesSuggestion": [
                "participantUserIds array-contains, startAt ASC"
            ]
        },
        "homeworks": {
            "docId": "homeworkId",
            "fields": {
                "subjectId": "string",
                "title": "string",
                "detail": "string",
                "assignedAt": "timestamp",
                "dueAt": "timestamp | null",
                "createdAt": "timestamp",
                "updatedAt": "timestamp"
            },
            "subcollections": {
                "submissions": {
                    "docId": "userId",
                    "fields": {
                        "status": "string (enum: not_started, in_progress, submitted, late, graded)",
                        "submittedAt": "timestamp | null",
                        "grade": "number | null",
                        "note": "string | null",
                        "updatedAt": "timestamp"
                    }
                }
            },
            "indexesSuggestion": [
                "subjectId ASC, dueAt ASC",
                "dueAt ASC"
            ]
        },
        "lectureNotes": {
            "docId": "noteId",
            "description": "Stores metadata only. HTML content is in external storage/filesystem.",
            "fields": {
                "subjectId": "string",
                "studyTimeId": "string | null",
                "title": "string",
                "contentUrl": "string",
                "contentVersion": "number",
                "createdByUserId": "string",
                "tags": "string[]",
                "createdAt": "timestamp",
                "updatedAt": "timestamp"
            },
            "indexesSuggestion": [
                "subjectId ASC, createdAt DESC",
                "createdByUserId ASC, createdAt DESC"
            ]
        }
    },
    "enums": {
        "studyTimeType": [
            "lecture",
            "lab",
            "tutorial",
            "exam",
            "other"
        ],
        "submissionStatus": [
            "not_started",
            "in_progress",
            "submitted",
            "late",
            "graded"
        ]
    }
}